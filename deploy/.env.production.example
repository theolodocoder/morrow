# Production settings for docker-compose.prod.yml. On the server: copy to .env.production at the repo root, fill in,
#   chmod 600 .env.production
# and never commit it. Compose hands each service only the values it needs (see docker-compose.prod.yml).
# Generate each secret with:  openssl rand -base64 48
# Values here are plain KEY=value lines: no spaces around "=", no `export`. Compose expands $ in unquoted and
# double-quoted values, so wrap any value containing $ in single quotes: KEY='a$b'.

# --- site (caddy, web, api, collab) ---
# The bare host name, no scheme. The site is https://$MORROW_DOMAIN and live editing is wss://collab.$MORROW_DOMAIN,
# so both need an A record pointing at the server.
MORROW_DOMAIN=morrow.example.org

# --- postgres (postgres, migrate, api, collab) ---
# Goes into a connection URL, so use hex (base64's + / = would need escaping):  openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME

# --- secrets (api; TICKET_SECRET and INTERNAL_SECRET are shared with collab). Min 32 chars each. ---
# Session signing for Better Auth. Changing it signs everyone out.
AUTH_SECRET=CHANGE_ME
# Live-editing tickets: the API mints them, collab verifies them.
TICKET_SECRET=CHANGE_ME
# Signs the API's internal calls to collab.
INTERNAL_SECRET=CHANGE_ME

# --- api: email (optional) ---
# With both set, Morrow sends real email through Resend (domain verified in Resend first); without them, production
# sends none (invitations still work by link).
# Leave both commented out to send no email (an empty value fails the API's validation).
# RESEND_API_KEY=re_CHANGE_ME
# EMAIL_FROM="Morrow <hello@morrow.example.org>"

# --- api: rate limits (per minute) ---
# Sign-in / sign-up attempts per visitor IP.
AUTH_RATE_LIMIT_PER_MINUTE=30
# Invitation previews per visitor IP.
PUBLIC_RATE_LIMIT_PER_MINUTE=30
# Every API request, per signed-in user (or per IP when signed out).
API_RATE_LIMIT_PER_MINUTE=300
# Discover's cache in ms (0 = off).
DISCOVER_CACHE_MS=15000
# TRUSTED_PROXIES and BILLING_ENABLED=false are fixed in docker-compose.prod.yml (they must match the compose network /
# stay off until a payment provider exists).

# --- web: read when the image is BUILT; after changing, rebuild (`up -d --build`) ---
# Voice-room ICE servers as JSON (RTCConfiguration.iceServers). STUN only: most home networks connect, some strict
# corporate/mobile networks won't. Never put TURN credentials here: this value is inlined into public JavaScript
# (anyone could relay through your TURN quota) and Cloudflare's credentials expire. See docs/DEPLOY.md §5.
NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.cloudflare.com:3478"}]
# Where staff open the admin console (only with `--profile admin`, over an SSH tunnel). Also allowed as an API origin.
ADMIN_PUBLIC_URL=http://localhost:3002

# --- backups (read by deploy/backup.sh only, not by any container) ---
# rclone remote "r2" defined entirely by environment: a Cloudflare R2 bucket via its S3 API.
# R2 dashboard → Manage API tokens → "Object Read & Write" on the backup bucket only.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=CHANGE_ME
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=CHANGE_ME
# https://<account id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# The token is scoped to one bucket, so don't try to create it.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
# Bucket (and optional folder) the dumps go to.
BACKUP_TARGET=morrow-backups/postgres
# Dumps older than this are deleted.
BACKUP_KEEP_DAYS=14
# Optional dead-man switch (e.g. a free healthchecks.io check, daily period): pinged after each good backup, and
# at <url>/fail on a failed one, so a backup that stops running gets noticed.
BACKUP_PING_URL=
