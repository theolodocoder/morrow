# Copy to .env for local development. Never commit .env. Generate secrets with: openssl rand -base64 48
# --- shared ---
DATABASE_URL=postgres://morrow:morrow@127.0.0.1:5432/morrow
# Shared by api (mints) and collab (verifies). Min 32 chars.
TICKET_SECRET=
# Signs internal api → collab requests. Min 32 chars.
INTERNAL_SECRET=

# --- api (apps/api) ---
API_PORT=4000
# Session signing for Better Auth. Min 32 chars.
AUTH_SECRET=
# The browser-facing origin; the API is served under /api on this origin.
WEB_ORIGIN=http://localhost:3000
# WebSocket URL the browser uses to reach collab.
COLLAB_PUBLIC_URL=ws://localhost:4001
# Private URL the API uses for collab's internal endpoints.
COLLAB_INTERNAL_URL=http://127.0.0.1:4001

# --- collab (apps/collab) ---
COLLAB_PORT=4001
# Comma-separated browser origins allowed to open WebSockets.
ALLOWED_ORIGINS=http://localhost:3000

# --- web (apps/web) reads API_INTERNAL_URL and COLLAB_PUBLIC_URL ---
API_INTERNAL_URL=http://127.0.0.1:4000

# Sign-in / sign-up attempts per IP per minute (production default 30).
AUTH_RATE_LIMIT_PER_MINUTE=30
# invitation previews per visitor per minute
PUBLIC_RATE_LIMIT_PER_MINUTE=30
# Every API request, per visitor per minute
API_RATE_LIMIT_PER_MINUTE=300
# hops allowed to report the visitor's IP (X-Forwarded-For): loopback in dev; your web servers / LB CIDRs in production
TRUSTED_PROXIES=loopback
# the staff admin app (separate origin; two-factor required for staff)
ADMIN_ORIGIN=http://localhost:3002
ADMIN_PUBLIC_URL=http://localhost:3002
# FR-033: billing runs disabled until a payment provider is chosen
BILLING_ENABLED=false
# Shared with the payment provider's webhook (min 32 chars). Leave unset while billing is disabled.
# BILLING_WEBHOOK_SECRET=at-least-32-characters
# Discover's per-instance cache in ms (0 = off; production default 15000)
DISCOVER_CACHE_MS=15000

# Email (optional). With both set, Morrow sends real email through Resend; without them, development logs emails.
# RESEND_API_KEY=
# EMAIL_FROM="Morrow <hello@your-domain.example>"

# The public address of the web app (share cards, sitemap). Defaults to http://localhost:3000.
# SITE_URL=https://morrow.example

# Voice rooms (optional): WebRTC ICE servers as JSON (RTCConfiguration.iceServers), read when the web app is built.
# Empty works on localhost and simple networks; across the internet, production needs a TURN server (e.g. coturn).
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"morrow","credential":"change-me"}]
